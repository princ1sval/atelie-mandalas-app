# Modelo do .env, que fica fora do git.
# Copie para ".env" e preencha com o firebaseConfig do app Web
# (console do Firebase › Configurações do projeto › Seus apps).
# Sem o .env o app abre normalmente; só a conta (entrar e criar conta) fica indisponível.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
