  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.26",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.22",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "firebase": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.16.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "sql.js": "^1.17.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:ui": "jest __tests__/ui",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test e2e/"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/data/mocks/**",
      "!src/types/**"
    ]
  },
  "private": true
